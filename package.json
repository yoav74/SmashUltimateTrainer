{
  "name": "smash-trainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @smash-trainer/web",
    "build": "npm run typecheck && npm run build -w @smash-trainer/web",
    "preview": "npm run preview -w @smash-trainer/web",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "scrape": "npm run scrape -w @smash-trainer/data",
    "scrape:resources": "npm run scrape:resources -w @smash-trainer/data"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vitest": "2.1.8",
    "vite": "5.4.10",
    "@vitejs/plugin-react": "4.3.3"
  }
}
