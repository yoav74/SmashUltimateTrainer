# Copy to apps/web/.env.local and fill in from Supabase: Project Settings → API Keys.
# The key is the publishable key (sb_publishable_...) or, on older projects, the anon key.
# Both values are public (they ship to the browser); row-level security protects user data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
